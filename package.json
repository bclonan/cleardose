{
  "name": "cleardose-demo",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/run-sites-command.mjs npm ci",
    "dev": "vite",
    "build": "node scripts/run-sites-command.mjs vite build",
    "start": "vite preview",
    "typecheck": "node scripts/run-sites-command.mjs vue-tsc --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "evals:contracts": "node scripts/validate-capability-catalog.mjs && node scripts/export-webmcp-schema.mjs && node scripts/export-webmcp-smoke.mjs && node scripts/validate-webmcp-evals.mjs",
    "evals:local": "npx webmcp-evals local -t evals/schema.json -e evals/cleardose.evals.json",
    "evals:smoke": "node scripts/export-webmcp-smoke.mjs && npx webmcp-evals smoke -u http://localhost:4173/#/demo -e evals/cleardose.smoke.json -v",
    "smoke:app": "node scripts/smoke-live-app.mjs",
    "test:build": "npm test && npm run build",
    "lint": "node scripts/run-sites-command.mjs eslint . --max-warnings 0"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@lucide/vue": "^1.37.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vue-tsc": "3.3.11"
  },
  "type": "module",
  "displayName": "ClearDose"
}
